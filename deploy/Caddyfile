# Salt Spring Ontology — production web server. Caddy container on the exe.dev VM.
# exe.dev terminates TLS at its proxy, so we serve plain HTTP on :80.
{
	admin off
	auto_https off
}

:80 {
	root * /srv/site
	encode gzip zstd

	# Vite emits content-hashed bundles under /assets/ — cache those forever.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else revalidates every request. House rule: no caching.
	@mutable not path /assets/*
	header @mutable Cache-Control "no-cache"

	try_files {path} {path}/ /index.html
	file_server
}
